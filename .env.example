# Application
APP_NAME=MindGuess AI
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://mindguess:mindguess@localhost:5432/mindguess

# Auth — JWT_SECRET is required (no default). App will not start if missing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS — comma-separated frontend origins. Never use * with credentials.
# Production: set this to the real frontend origin(s) only.
# Development: localhost/127.0.0.1 Vite ports 5173–5199 are allowed automatically
# (Vite may bump the port when 5173 is busy). Localhost is never auto-allowed
# when ENVIRONMENT=production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Engine thresholds (TDD v1.1 defaults)
ELIMINATION_FLOOR=0.0005
ELIMINATION_MAGNITUDE=1000
CONFIDENCE_HIGH=0.85
CONFIDENCE_SEPARATION=0.6
CONFIDENCE_MARGIN=0.4
MAX_QUESTIONS=25
LEARNING_RATE=0.07
CONSECUTIVE_DONT_KNOW_CAP=5
IG_TIE_THRESHOLD=0.001
SESSION_ABANDON_MINUTES=30
NEW_QUESTION_MIN_SAMPLES=5

# Live session cache (Redis shared across API workers / replicas).
# Render Free without Redis: set SESSION_CACHE_BACKEND=memory so boot does not
# wait on a localhost Redis TCP timeout. Gameplay does not require Redis.
SESSION_CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=mindguess:

# Celery background workers (defaults to REDIS_URL when unset)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=5
CELERY_RETRY_DELAY_SECONDS=5

# Rate limiting (auth + game). Override at runtime via PUT /admin/rate-limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP=20
RATE_LIMIT_AUTH_IP_WINDOW=60
RATE_LIMIT_AUTH_USER=40
RATE_LIMIT_AUTH_USER_WINDOW=60
RATE_LIMIT_GAME_IP=120
RATE_LIMIT_GAME_IP_WINDOW=60
RATE_LIMIT_GAME_USER=180
RATE_LIMIT_GAME_USER_WINDOW=60

# Monitoring — Prometheus scrape at GET /metrics
# Render Health Check Path MUST be /health/live (no database).
# GET /health and GET /health/ready still ping Postgres for diagnostics.
